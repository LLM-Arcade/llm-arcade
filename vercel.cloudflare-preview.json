{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-vercel.mjs preview",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://llm-arcade-api-preview.jeffkazzee.workers.dev/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://llm-arcade-api-preview.jeffkazzee.workers.dev/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
